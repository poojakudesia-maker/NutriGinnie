# ---------------------------------------------------------------------------
# NutriPing environment variables
# Copy this file to .env (local dev) or configure the same keys in your
# hosting provider's dashboard (Vercel / Railway / Render).
# ---------------------------------------------------------------------------

# --- Database (Prisma / PostgreSQL) -----------------------------------------
# Works unmodified with Supabase, Neon, Railway Postgres, or a local instance.
DATABASE_URL="postgresql://user:password@localhost:5432/nutriping?schema=public"

# --- Google Sign-In (optional) ----------------------------------------------
# Create an OAuth 2.0 Client ID (Web application) at
# https://console.cloud.google.com/apis/credentials, with an authorized
# redirect URI of "<APP_URL>/api/auth/google/callback". Leave blank to hide
# the "Continue with Google" button's functionality (it will show a friendly
# error instead of crashing).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI layer (Claude) -------------------------------------------------------
# Used for PDF parsing, recipe structuring, and diet plan generation.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# --- WhatsApp messaging: Meta Cloud API (default) ---------------------------
# WhatsApp Business policy only allows freeform text within a 24-hour window after the user last
# messaged in. The nightly reminder is proactive (nobody necessarily replied first), so it needs a
# pre-approved Utility-category template — create one in Meta Business Suite -> WhatsApp Manager ->
# Message Templates, body = a single {{1}} variable (e.g. "Here's your plan for tomorrow: {{1}}"),
# wait for approval, then set its name below. See README "WhatsApp integration steps (Meta Cloud
# API)" for the full walkthrough (getting a permanent token, webhook setup, etc.).
WHATSAPP_PROVIDER="meta_template" # "meta_template" (default) | "twilio" (freeform, sandbox/dev only)
WHATSAPP_TEMPLATE_NAME="" # required when WHATSAPP_PROVIDER=meta_template
META_WHATSAPP_TOKEN="" # permanent System User token, NOT the 24h temporary one
META_PHONE_NUMBER_ID=""
META_APP_SECRET="" # App dashboard -> Settings -> Basic -> App Secret; verifies inbound webhook signatures
META_WEBHOOK_VERIFY_TOKEN="" # any string you make up yourself; must match what you enter in the Meta webhook config

# --- WhatsApp messaging: Twilio (optional — only needed for voice notes) ---
# Meta's Cloud API can't send freeform audio outside an active chat session, so voice notes stay
# on Twilio even when WHATSAPP_PROVIDER=meta_template. Leave these blank to just skip voice notes
# entirely (the nightly text + grocery message still sends fine via Meta on its own).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""

# --- Text-to-speech (voice notes) -------------------------------------------
# Provide ONE of the two. ElevenLabs is used first if both are set.
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"
GOOGLE_TTS_API_KEY=""

# --- Scheduler ---------------------------------------------------------------
# Shared secret checked on every /api/cron/* request (Vercel Cron sends this
# automatically as `Authorization: Bearer <CRON_SECRET>` once the env var is set;
# scripts/scheduler.ts uses it too for Railway/Render deployments).
CRON_SECRET="change-me-to-a-long-random-string"

# --- App URL -----------------------------------------------------------------
# Public base URL of the deployed app (no trailing slash). Required so the
# WhatsApp voice-note media URL and the standalone scheduler can reach the app.
APP_URL="https://your-app.vercel.app"
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
