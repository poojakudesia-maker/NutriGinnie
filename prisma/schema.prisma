// NutriPing database schema
// Provider: PostgreSQL (Supabase / Neon / Railway all work unmodified)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  HIGH
}

enum DietType {
  VEG
  EGGETARIAN
  NON_VEG
}

enum RecipeSource {
  PDF
  INSTAGRAM
  MANUAL_TEXT
  AI_GENERATED
}

enum MealSlot {
  BREAKFAST
  SNACK_1
  LUNCH
  SNACK_2
  DINNER
}

enum WhatsAppMessageType {
  DIET_TEXT
  DIET_VOICE
  GROCERY_TEXT
}

enum WhatsAppStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model User {
  id String @id @default(cuid())

  // Login credentials
  email        String @unique
  passwordHash String

  // Basic profile
  name           String
  age            Int
  gender         Gender
  heightCm       Float
  weightKg       Float
  targetWeightKg Float
  activityLevel  ActivityLevel

  // Health inputs
  medicalConditions String[] @default([])
  isGlp1            Boolean  @default(false)
  glp1Medication    String?
  glp1DosageMg      Float?

  // Food preferences
  dietType          DietType @default(VEG)
  allergies         String[] @default([])
  cuisinePreference String[] @default(["Indian"])

  // WhatsApp (max 2 enforced at the application layer, see lib/validation)
  whatsappNumbers String[] @default([])

  // Calculation engine outputs (cached, recomputed whenever profile changes)
  bmi              Float?
  bmr              Float?
  tdee             Float?
  calorieTarget    Float?
  proteinTargetG   Float?
  deficitKcal      Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipes       Recipe[]
  mealPlans     MealPlan[]
  groceries     Grocery[]
  whatsAppLogs  WhatsAppLog[]
  weightLogs    WeightLog[]
  waterLogs     WaterLog[]

  @@map("users")
}

model Recipe {
  id     String       @id @default(cuid())
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String
  source       RecipeSource
  sourceUrl    String?
  rawInput     String? // original pasted text / instagram caption / pdf excerpt

  ingredients  Json // [{ name, quantity, unit }]
  instructions String?

  calories  Float?
  proteinG  Float?
  carbsG    Float?
  fatG      Float?
  fiberG    Float?
  ironMg    Float?
  calciumMg Float?
  micros    Json? // any additional micronutrients { key: value }

  aiEstimated Boolean @default(false) // true if nutrition was AI-estimated (missing source data)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("recipes")
}

model MealPlan {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  weekStartDate DateTime // Monday of the plan week (date-only, stored at midnight UTC)
  dayIndex      Int // 0..6 (0 = weekStartDate)
  dayLabel      String // "Monday", "Tuesday", ...

  meals Json // { breakfast, snack1, lunch, snack2, dinner } each: { name, recipeId?, calories, proteinG, carbsG, fatG, fiberG, ingredients }

  totalCalories Float
  totalProteinG Float
  totalCarbsG   Float
  totalFatG     Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weekStartDate, dayIndex])
  @@index([userId])
  @@map("meal_plans")
}

model Grocery {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  forDate DateTime // date the grocery list is needed for (i.e. the day the ingredients get cooked)
  items   Json // [{ name, quantity, unit, category }]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, forDate])
  @@index([userId])
  @@map("groceries")
}

model WhatsAppLog {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  phoneNumber       String
  messageType       WhatsAppMessageType
  status            WhatsAppStatus      @default(QUEUED)
  providerMessageId String?
  errorMessage      String?
  payloadPreview    String? // first ~200 chars of the message body, for debugging

  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@map("whatsapp_logs")
}

// Bonus: weight tracking graph
model WeightLog {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg Float
  loggedAt DateTime @default(now())

  @@index([userId])
  @@map("weight_logs")
}

// Bonus: water intake tracker
model WaterLog {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountMl Int
  loggedAt DateTime @default(now())

  @@index([userId])
  @@map("water_logs")
}
