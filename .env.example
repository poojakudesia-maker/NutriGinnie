# ---------------------------------------------------------------------------
# NutriPing environment variables
# Copy this file to .env (local dev) or configure the same keys in your
# hosting provider's dashboard (Vercel / Railway / Render).
# ---------------------------------------------------------------------------

# --- Database (Prisma / PostgreSQL) -----------------------------------------
# Works unmodified with Supabase, Neon, Railway Postgres, or a local instance.
DATABASE_URL="postgresql://user:password@localhost:5432/nutriping?schema=public"

# --- Google Sign-In (optional) ----------------------------------------------
# Create an OAuth 2.0 Client ID (Web application) at
# https://console.cloud.google.com/apis/credentials, with an authorized
# redirect URI of "<APP_URL>/api/auth/google/callback". Leave blank to hide
# the "Continue with Google" button's functionality (it will show a friendly
# error instead of crashing).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI layer (Claude) -------------------------------------------------------
# Used for PDF parsing, recipe structuring, and diet plan generation.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# --- WhatsApp messaging: Twilio (default) -----------------------------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Twilio WhatsApp sender, in the form "whatsapp:+14155238886" (sandbox) or your
# approved WhatsApp Business number.
TWILIO_WHATSAPP_FROM=""

# --- WhatsApp messaging: Meta Cloud API (alternative to Twilio) ------------
# WhatsApp Business policy only allows freeform text (the Twilio default below) within a 24-hour
# window after the user last messaged in. A nightly reminder nobody replied to falls outside that
# window and needs a pre-approved Utility-category template instead, or it will simply get
# rejected once you're off the Twilio sandbox. To use one: create a template in Meta Business
# Manager whose body is a single {{1}} variable (e.g. "Here's your plan for tomorrow: {{1}}"), wait
# for approval, then set:
WHATSAPP_PROVIDER="twilio" # "twilio" (freeform, sandbox/dev default) | "meta_template" (production)
WHATSAPP_TEMPLATE_NAME="" # required when WHATSAPP_PROVIDER=meta_template
META_WHATSAPP_TOKEN=""
META_PHONE_NUMBER_ID=""

# --- Text-to-speech (voice notes) -------------------------------------------
# Provide ONE of the two. ElevenLabs is used first if both are set.
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"
GOOGLE_TTS_API_KEY=""

# --- Scheduler ---------------------------------------------------------------
# Shared secret checked on every /api/cron/* request (Vercel Cron sends this
# automatically as `Authorization: Bearer <CRON_SECRET>` once the env var is set;
# scripts/scheduler.ts uses it too for Railway/Render deployments).
CRON_SECRET="change-me-to-a-long-random-string"

# --- App URL -----------------------------------------------------------------
# Public base URL of the deployed app (no trailing slash). Required so the
# WhatsApp voice-note media URL and the standalone scheduler can reach the app.
APP_URL="https://your-app.vercel.app"
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
